# Maintainer: Roberto Flores <25asab015@ujmd.edu.sv>
#
# ravn-git-bare-clone: launcher y runtime modular de clonacion bare y gestion de worktrees.
# Repositorio fuente privado; tarball vendoreado como fuente local con sha256
# para permitir compilacion transparente en la Action release-personal sin secretos.

pkgname=ravn-git-bare-clone
pkgver=0.1.0
pkgrel=1
pkgdesc='Launcher y runtime modular de clonación bare y gestión de worktrees'
arch=('any')
url='https://github.com/robert-flo/ravn-git-bare-clone'
license=('MIT')
options=('!debug')
depends=('git' 'github-cli' 'jq')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('6ea6d7690304218a1504cad180c389eb36fb9e3a1b47f0c093dd7238a065a7fd')

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make install DESTDIR="${pkgdir}" PREFIX="/opt/${pkgname}" BINDIR="/usr/bin"
}
